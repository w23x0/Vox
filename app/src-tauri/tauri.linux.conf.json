{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libpipewire-0.3-0"
        ],
        "section": "sound",
        "priority": "optional",
        "desktopTemplate": "linux/vox.desktop.hbs"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "pipewire"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
